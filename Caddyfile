www.bosfoot.com {
    redir https://bosfoot.com{uri} permanent
}

bosfoot.com {
    encode gzip zstd

    # Access logging — per-request JSON, so the funnel/traffic scripts
    # (scripts/funnel.sh, scripts/traffic.sh) have data to read.
    log {
        output stderr
        format json
    }

    # Approved review photos (user uploads). MUST come before @static, or the
    # *.webp rule below would try to serve them from /public and 404. They live
    # OUTSIDE the repo (UPLOADS_DIR) so `git reset --hard` deploys don't wipe them.
    # Only the "public" subdir is served; pending/rejected photos are never here.
    handle /uploads/* {
        root * /srv/bosfoot/uploads/public
        uri strip_prefix /uploads
        header Cache-Control "public, max-age=604800"
        file_server
    }

    # Let Caddy serve static files directly for better performance.
    @static {
        path *.css *.js *.webp *.jpg *.jpeg *.png *.svg *.woff2 *.json *.webmanifest *.txt
    }

    handle @static {
        root * /srv/bosfoot/public

        # Versioned assets (?v=...) get a 1 year "immutable" cache (hard-refresh proof).
        @versioned query v=*
        header @versioned Cache-Control "public, max-age=31536000, immutable"

        # Non-versioned static files get 7 days.
        @unversioned not query v=*
        header @unversioned Cache-Control "public, max-age=604800, must-revalidate"

        file_server
    }

    # Everything else (Pages, API, Sitemap) goes to the Go backend. Caddy sets
    # X-Forwarded-For/Proto/Host automatically — no header_up needed.
    reverse_proxy localhost:8080

    # Standard Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Isolate the top-level window from anything it opens. Safe: no cross-origin
        # popups need window.opener (guest checkout, no OAuth/payment popups).
        Cross-Origin-Opener-Policy "same-origin"
    }
}
