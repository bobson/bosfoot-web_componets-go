www.bosfoot.com {
    redir https://bosfoot.com{uri} permanent
}

bosfoot.com {
    encode gzip zstd

    # Let Caddy serve static files directly for better performance.
    # It will check the 'public' folder first for these extensions.
    @static {
        path *.css *.js *.webp *.jpg *.jpeg *.png *.svg *.woff2 *.json *.webmanifest *.txt
    }
    
    handle @static {
        root * public
        
        # 1. Versioned assets (?v=...) get 1 year "immutable" cache.
        # This solves the hard-refresh problem for users.
        @versioned query v=*
        header @versioned Cache-Control "public, max-age=31536000, immutable"

        # 2. Non-versioned static files get 7 days.
        @unversioned not query v=*
        header @unversioned Cache-Control "public, max-age=604800, must-revalidate"

        file_server
    }

    # Everything else (Pages, API, Sitemap) goes to the Go backend
    reverse_proxy localhost:8080 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    # Standard Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
